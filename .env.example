# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Alpaca API credentials.
# Paper keys: https://app.alpaca.markets/paper/dashboard/overview
# Live keys:  https://app.alpaca.markets/live/dashboard/overview
ALPACA_API_KEY=your_key_here
ALPACA_SECRET_KEY=your_secret_here

# true  -> paper trading endpoint (https://paper-api.alpaca.markets)
# false -> LIVE MONEY endpoint   (https://api.alpaca.markets)
# Switching this to false is the ONLY code-side change needed to go live.
ALPACA_PAPER=true

# Discord incoming webhook for alerts.
# Discord: Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy URL
ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/xxxxxxxx/yyyyyyyy
